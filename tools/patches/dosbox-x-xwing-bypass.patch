+/* The port's bypass (src/runtime/protection.c), the same steps: the screen's
+ * data segment is the DGROUP word 6562h; its glyph triple at +0 is the
+ * question's row of the table at +1222h, the wrong tries at +0Eh are 0, the
+ * triple is frozen (+3Ah = 1), the question index at +0E06h; AX = 1 and the
+ * call (push cs; call near) is skipped. Every other register and the flags
+ * stay as they were at the call. */
+bool XWING_Bypass(const uint32_t linear) {
+	if (!xwing_active) return false;
+	const Location here = Locate(linear);
+	if (here.module != bypass_at.module || here.offset != bypass_at.offset) return false;
+	const uint32_t seg = (uint32_t)mem_readw(SegPhys(ds) + 0x6562) << 4;
+	for (uint32_t i = 0; i < 3; ++i)
+		mem_writew(seg + 2 * i, mem_readw(seg + 0x1222 + 2 * (bypass_question * 3 + i)));
+	mem_writew(seg + 0x0e, 0);
+	mem_writew(seg + 0x3a, 1);
+	mem_writew(seg + 0xe06, (uint16_t)bypass_question);
+	reg_ax = 1;
+	reg_eip = (uint16_t)(reg_eip + bypass_len);
+	++bypass_hits;
+	Event("bypass", "%s+0x%05x question=%u", bypass_at.module_name.c_str(), bypass_at.offset,
+	      bypass_question);
+	LOG_MSG("XWING: copy-protection bypass at icount %llu", (unsigned long long)icount);
+	return true;
 }
 
