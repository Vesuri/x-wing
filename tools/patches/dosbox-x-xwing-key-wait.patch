+namespace {
+
+bool BlockingKeyRead(const uint32_t linear) {
+	if (mem_readb(linear) != 0xcd) return false;
+	const uint8_t vec = mem_readb(linear + 1);
+	if (vec == 0x21) return reg_ah == 0x01 || reg_ah == 0x07 || reg_ah == 0x08;
+	return vec == 0x16 && (reg_ah == 0x00 || reg_ah == 0x10);
+}
+
+/* The next key, if its trigger fires at this blocking read: pressed here,
+ * with the bookkeeping XWING_Instruction would do for this visit. */
+void KeyAtBlockingRead(const uint32_t linear) {
+	if (key_held != KBD_NONE || key_index >= keys.size() || !BlockingKeyRead(linear)) return;
+	auto &t = keys[key_index];
+	if (t.done || SwotlParseJoystick(t.name).kind || MouseAction(t.name)) return;
+	const Location here = Locate(linear);
+	if (!IsPoll(here) || !Hit(t, here)) return;
+	++key_index;
+	t.done = true;
+	KeyModifiers(t.modifiers, true);
+	KEYBOARD_AddKey(t.key, true);
+	key_held = t.key;
+	held_trigger_hits = 0;
+	key_release_at = icount + 1 + key_hold;
+	key_wait = key_wait_skip = true;
+	key_wait_linear = linear;
+	key_wait_cycles = 0;
+	Event("key_down", "%s wait", t.name.c_str());
+}
