+void XWING_DmaRead(const uint8_t channel, const uint32_t linear, const uint8_t *data, const unsigned bytes) {
+	if (!xwing_active || !dma_log || !bytes) return;
+	DmaRun &r = dma_runs[channel & 7];
+	if (r.open && linear != r.next) FlushDma(channel, "break");
+	if (!r.open) {
+		r.open = true;
+		r.ms0 = (double)PIC_FullIndex();
+		r.linear0 = linear;
+		r.bytes = 0;
+		r.fnv = 0xcbf29ce484222325ull;
+	}
+	for (unsigned i = 0; i < bytes; ++i) r.fnv = (r.fnv ^ data[i]) * 0x100000001b3ull;
+	r.bytes += bytes;
+	r.next = linear + bytes;
+}
+
+void XWING_DmaTc(const uint8_t channel) {
+	if (xwing_active) FlushDma(channel, "tc");
+}
