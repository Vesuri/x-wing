+void XWING_DmaRead(const uint8_t channel, const uint32_t linear, const uint8_t *data, const unsigned bytes) {
+	if (!xwing_active || !dma_log || !bytes) return;
+	DmaRun &r = dma_runs[channel & 7];
+	if (r.open && linear != r.next) FlushDma(channel, "break");
+	if (!r.open) {
+		r.open = true;
+		r.ms0 = (double)PIC_FullIndex();
+		r.linear0 = linear;
+		r.bytes = 0;
+		r.fnv = 0xcbf29ce484222325ull;
+	}
+	for (unsigned i = 0; i < bytes; ++i) r.fnv = (r.fnv ^ data[i]) * 0x100000001b3ull;
+	r.bytes += bytes;
+	r.next = linear + bytes;
+}
+
+void XWING_DmaWrite(const uint8_t channel, const uint32_t linear, const uint8_t *data, const unsigned bytes) {
+	if (!xwing_active || !bytes) return;
+	static const uint16_t dma_module = ModuleId("DMA");
+	const uint64_t w = WRITTEN | Pack(Location{dma_module, channel});
+	for (uint32_t a = linear; a < linear + bytes && a < PARAGRAPHS * 16; ++a) last_writer[a] = w;
+	if (!dma_log) return;
+	uint64_t fnv = 0xcbf29ce484222325ull;
+	for (unsigned i = 0; i < bytes; ++i) fnv = (fnv ^ data[i]) * 0x100000001b3ull;
+	const double ms = (double)PIC_FullIndex();
+	fprintf(dma_log, "%.6f,%.6f,%u,write,0x%05x,%u,%016llx,write\n", ms, ms, channel, linear, bytes,
+	        (unsigned long long)fnv);
+}
+
+void XWING_DmaTc(const uint8_t channel) {
+	if (xwing_active) FlushDma(channel, "tc");
+}
