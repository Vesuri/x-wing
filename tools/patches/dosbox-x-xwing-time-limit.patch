--- a/src/misc/xwing_trace.cpp
+++ b/src/misc/xwing_trace.cpp
@@ -284,6 +284,7 @@
 
 void WriteOutputs() {
 	if (!enabled) return;
+	enabled = false; /* once: at the time limit or at exit */
 	if (events) fflush(events);
 	if (auto *f = fopen(Path("modules.csv").c_str(), "w")) {
 		fputs("module,loads,executed_bytes,size\n", f);
@@ -808,3 +809,9 @@
 	if (!xwing_active) return;
 	Event("exec_overlay", "%s seg=0x%04x reloc=0x%04x", BaseName(name).c_str(), seg, reloc);
 }
+
+/* -time-limit (pic.cpp): the outputs while guest memory is still mapped; at
+ * exit it is gone (OverlayName reads the PLINK table). */
