+/* Retrace log (XWING_RETRACE=1): every read of the VGA input status port 3DAh by
+ * module code, as runs of one value within one service-event interval (the host
+ * run replays them, tests/host_run.py). */
+FILE *retrace_ports = nullptr;
+struct RetraceRun {
+    uint64_t service = 0, count = 0;
+    uint32_t value = 0;
+} retrace_run;
+void FlushRetrace() {
+    if (!retrace_ports || !retrace_run.count) return;
+    if (fprintf(retrace_ports, "%llu,%u,%llu\n", (unsigned long long)retrace_run.service,
+                (unsigned)retrace_run.value, (unsigned long long)retrace_run.count) < 0)
+        E_Exit("XWING: cannot write retrace.csv");
+    retrace_run.count = 0;
 }
